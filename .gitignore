# Local .terraform directories
**/.terraform/*

# State files — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# tfvars typically contain secrets (API keys, account-specific values)
*.tfvars
*.tfvars.json
!example.tfvars
!example.tfvars.json

# Override files used for local-only experimentation
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Saved plan outputs
*.tfplan
*.tfplan.*

# Lambda zip artifacts (regenerated by archive_file data source)
modules/compute/build/

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# NOTE: .terraform.lock.hcl SHOULD be committed — it pins provider versions
# for reproducible plans across the team.
